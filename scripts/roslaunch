#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
package="${1:-}"
launch_file="${2:-}"
shift 2 || true

if [[ "$package" != "ecolivo" || "$launch_file" != "mapping_avia.launch" ]]; then
    echo "Usage: roslaunch ecolivo mapping_avia.launch [arg:=value ...]" >&2
    exit 2
fi

sequence="synthetic/ecolivo-wsl"
output="results/ecolivo"
fps="1"
threads="1"
shock=""
uav_hybrid=true
gui=false

for arg in "$@"; do
    case "$arg" in
        sequence:=*) sequence="${arg#sequence:=}" ;;
        output:=*) output="${arg#output:=}" ;;
        fps:=*) fps="${arg#fps:=}" ;;
        threads:=*) threads="${arg#threads:=}" ;;
        test_shock:=*) shock="${arg#test_shock:=}" ;;
        gui:=true) gui=true ;;
        gui:=false) gui=false ;;
        uav_hybrid:=true) uav_hybrid=true ;;
        uav_hybrid:=false) uav_hybrid=false ;;
        *) echo "Ignoring unknown launch argument: $arg" >&2 ;;
    esac
done

if [[ ! -d "$ROOT/$sequence" && ! -d "$sequence" ]]; then
    echo "Warning: sequence directory '$sequence' not found. Defaulting to synthetic/ecolivo-wsl" >&2
    sequence="synthetic/ecolivo-wsl"
fi

args=(--sequence "$sequence" --output "$output" --fps "$fps" --threads "$threads")
if [[ "$uav_hybrid" == true ]]; then
    args+=(--uav-hybrid)
fi
if [[ -n "$shock" ]]; then
    args+=(--test-shock "$shock")
fi
if [[ "$gui" == true ]]; then
    args+=(--gui)
fi
exec "$ROOT/scripts/run_wsl_simulation.sh" launch "${args[@]}"
